import { Theme } from "theme.slint";
import { App } from "state.slint";
import { TodayPage } from "today.slint";
import { ApplicationsPage, NewApplication } from "applications.slint";
import { ApplicationPage, CloseDialog } from "application.slint";
import { ProfilePage } from "profile.slint";
import { SettingsPage } from "settings.slint";
import { DiscoverPage } from "discover.slint";
import { CompaniesPage } from "companies.slint";
import { SetupPage } from "setup.slint";
import { Viewer } from "viewer.slint";

export { App }
export { JobRow, JobDetail, VersionRow, VersionDetail, CheckRow, RoundRow, WorkLine, ChatRow, TemplateRow, EventRow,
         ProfileRow, ProfileForm, DocRow, ProviderRow, AiForm, SearchForm, SetupStep, CompanyRow, PostingRow, DiscoverRow } from "state.slint";

component NavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    in property <int> count: 0;
    callback clicked;
    height: 40px;
    border-radius: Theme.r-control;
    background: active ? Theme.rail-active : touch.has-hover ? Theme.rail-active.with-alpha(0.5) : transparent;
    touch := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
    if root.active : Rectangle { x: 0; width: 3px; height: 18px; y: (parent.height - 18px) / 2; border-radius: 2px; background: Theme.marigold; }
    HorizontalLayout {
        padding-left: 14px; padding-right: 12px; spacing: 12px;
        Image { source: root.icon; width: 18px; height: 18px; y: (parent.height - 18px) / 2;
                colorize: root.active ? Theme.rail-ink : Theme.rail-muted; }
        Text { text: root.text; font-family: Theme.body; font-size: Theme.fs-sm; font-weight: root.active ? 700 : 500;
               color: root.active ? Theme.rail-ink : Theme.rail-muted; vertical-alignment: center; horizontal-stretch: 1; }
        if root.count > 0 : Rectangle {
            width: max(22px, n.preferred-width + 12px); height: 20px; y: (parent.height - 20px) / 2; border-radius: 10px;
            background: Theme.marigold;
            n := Text { text: root.count; font-family: Theme.body; font-size: 12px; font-weight: 700; color: #3A2604;
                        horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
}

component Wordmark inherits HorizontalLayout {
    spacing: 10px;
    Rectangle {                                    // a tiny line with three stops
        width: 34px; height: 34px; border-radius: 10px; background: #ffffff14;
        Rectangle { x: 7px; y: 16px; width: 20px; height: 3px; border-radius: 1.5px; background: #ffffff60; }
        Rectangle { x: 5px; y: 13px; width: 8px; height: 8px; border-radius: 4px; background: #1F9D6E; }
        Rectangle { x: 13px; y: 13px; width: 8px; height: 8px; border-radius: 4px; background: #3B7DD8; }
        Rectangle { x: 20px; y: 11px; width: 12px; height: 12px; border-radius: 6px; background: Theme.marigold; }
    }
    VerticalLayout {
        alignment: center;
        Text { text: "Job Command"; font-family: Theme.display; font-weight: 700; font-size: 16px; color: Theme.rail-ink; }
        Text { text: "Center"; font-family: Theme.display; font-weight: 700; font-size: 16px; color: Theme.rail-muted; }
    }
}

component NewButton inherits Rectangle {
    callback clicked;
    height: 40px;
    border-radius: Theme.r-control;
    background: touch.pressed ? Theme.marigold.darker(0.15) : touch.has-hover ? Theme.marigold.brighter(0.1) : Theme.marigold;
    Text { text: "+  New application"; font-family: Theme.body; font-size: Theme.fs-sm; font-weight: 700; color: #3A2604; }
    touch := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
    accessible-role: button;
    accessible-label: "New application";
    accessible-action-default => { root.clicked(); }
}

component Toast inherits Rectangle {
    visible: App.toast != "";
    height: t.preferred-height + 24px;
    width: min(560px, t.preferred-width + 36px);
    border-radius: Theme.r-control;
    background: Theme.dark ? #E7EFED : #0F2A2E;
    t := Text { width: parent.width - 36px; text: App.toast; wrap: word-wrap; font-family: Theme.body; font-size: Theme.fs-sm;
                color: Theme.dark ? #0F2A2E : #E7EFED; horizontal-alignment: center; }
}

export component AppWindow inherits Window {
    title: "Job Command Center";
    icon: @image-url("../assets/icon-256.png");
    preferred-width: 1400px;
    preferred-height: 900px;
    min-width: 1080px;
    min-height: 680px;
    background: Theme.paper;
    default-font-family: Theme.body;

    HorizontalLayout {
        Rectangle {
            width: 240px;
            background: Theme.rail;
            VerticalLayout {
                padding: 18px; padding-top: 24px; spacing: 6px;
                Wordmark { }
                Rectangle { height: 18px; }
                NewButton { clicked => { App.adding = true; } }
                Rectangle { height: 10px; }
                NavItem { text: "Today"; icon: @image-url("icons/today.svg"); active: App.page == 0 && App.open-job < 0; count: App.today.length; clicked => { App.go(0); } }
                NavItem { text: "Applications"; icon: @image-url("icons/applications.svg"); active: App.page == 1 || App.open-job >= 0; count: App.working-count; clicked => { App.go(1); } }
                NavItem { text: "Discover"; icon: @image-url("icons/discover.svg"); active: App.page == 2 && App.open-job < 0; clicked => { App.go(2); } }
                NavItem { text: "Companies"; icon: @image-url("icons/companies.svg"); active: App.page == 3 && App.open-job < 0; clicked => { App.go(3); } }
                Rectangle { height: 1px; background: #ffffff18; }
                NavItem { text: "Profile"; icon: @image-url("icons/profile.svg"); active: App.page == 4 && App.open-job < 0; clicked => { App.go(4); } }
                NavItem { text: "Settings"; icon: @image-url("icons/settings.svg"); active: App.page == 5 && App.open-job < 0; clicked => { App.go(5); } }
                Rectangle { vertical-stretch: 1; }
                if App.index-line != "" : Text { text: App.index-line; font-family: Theme.body; font-size: Theme.fs-xs; color: Theme.rail-muted; wrap: word-wrap; }
                Text { text: App.status-line; font-family: Theme.body; font-size: Theme.fs-xs; color: Theme.rail-muted; wrap: word-wrap; }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            if App.open-job >= 0 : ApplicationPage { }
            if App.open-job < 0 && App.page == 0 : TodayPage { }
            if App.open-job < 0 && App.page == 1 : ApplicationsPage { }
            if App.open-job < 0 && App.page == 2 : DiscoverPage { }
            if App.open-job < 0 && App.page == 3 : CompaniesPage { }
            if App.open-job < 0 && App.page == 4 : ProfilePage { }
            if App.open-job < 0 && App.page == 5 : SettingsPage { }
        }
    }
    if App.adding : NewApplication { }
    if App.setup-stage >= 0 : SetupPage { }
    if App.viewer-open : Viewer { }
    if App.closing : CloseDialog { }
    Toast { x: (parent.width - self.width) / 2 + 120px; y: parent.height - self.height - 24px; }
}
