// Discover: new postings from the user's favourite companies that match their places.
import {ListView } from "std-widgets.slint";
import { Theme, Monogram } from "theme.slint";
import { App, DiscoverRow } from "state.slint";
import { ActionButton, LinkButton, SearchField, Working, Chip, Select, Pager } from "widgets.slint";

export component ScanBar inherits Rectangle {
    visible: App.scanning;
    height: App.scanning ? 56px : 0px;
    border-radius: Theme.r-panel;
    background: Theme.surface;
    border-width: 1px; border-color: Theme.line;
    HorizontalLayout {
        padding: 14px; spacing: 14px;
        Working { }
        VerticalLayout { horizontal-stretch: 1; spacing: 6px; alignment: center;
            Text { text: App.scan-line; font-family: Theme.body; font-size: Theme.fs-xs; color: Theme.ink; overflow: elide; }
            Rectangle { height: 6px; border-radius: 3px; background: Theme.sunken;
                Rectangle { x: 0; width: parent.width * App.scan-progress; border-radius: 3px; background: Theme.accent; animate width { duration: 200ms; } } } }
        Text { text: round(App.scan-progress * 100) + "%"; font-family: Theme.display; font-weight: 700; font-size: Theme.fs-md; color: Theme.ink; vertical-alignment: center; }
    }
}

component DiscoverItem inherits Rectangle {
    in property <DiscoverRow> d;
    height: 68px;
    border-radius: Theme.r-panel;
    background: touch.has-hover ? Theme.surface : transparent;
    touch := TouchArea { }
    HorizontalLayout {
        padding-left: 16px; padding-right: 16px; spacing: 14px;
        Monogram { initial: d.initial; hue-seed: d.hue; size: 38px; y: (parent.height - 38px) / 2; }
        VerticalLayout { alignment: center; spacing: 3px; horizontal-stretch: 1;
            Text { text: d.title; font-family: Theme.body; font-size: Theme.fs-md; font-weight: 700; color: Theme.ink; overflow: elide; }
            Text { text: d.company + (d.location == "" ? "" : ", " + d.location); font-family: Theme.body; font-size: Theme.fs-xs; color: Theme.muted; overflow: elide; } }
        Text { width: 90px; text: d.seen; font-family: Theme.body; font-size: Theme.fs-xs; color: Theme.faint; vertical-alignment: center; }
        HorizontalLayout { width: 260px; spacing: 8px; alignment: end;
            VerticalLayout { alignment: center; LinkButton { text: "View"; clicked => { App.open-url(d.url); } } }
            if d.job-id > 0 : VerticalLayout { alignment: center; ActionButton { text: "Open application"; small: true; clicked => { App.open-job-page(d.job-id); } } }
            if d.job-id <= 0 && d.state != "dismissed" : VerticalLayout { alignment: center; ActionButton { text: "Dismiss"; small: true; clicked => { App.dismiss-discovered(d.id); } } }
            if d.job-id <= 0 : VerticalLayout { alignment: center; ActionButton { text: "Tailor"; small: true; primary: true; clicked => { App.queue-discovered(d.id); } } } }
    }
    Rectangle { x: 16px; width: parent.width - 32px; y: parent.height - 1px; height: 1px; background: Theme.line; }
}

export component DiscoverPage inherits Rectangle {
    background: Theme.paper;
    VerticalLayout {
        padding: 36px; padding-bottom: 0; spacing: 16px;
        HorizontalLayout {
            VerticalLayout { horizontal-stretch: 1; spacing: 4px;
                Text { text: "Discover"; font-family: Theme.display; font-weight: 700; font-size: Theme.fs-xxl; color: Theme.ink; letter-spacing: -0.5px; }
                Text { text: "Open roles at your favourite companies, in the places you want to work. Anything you already track is left out.";
                       wrap: word-wrap; font-family: Theme.body; font-size: Theme.fs-sm; color: Theme.muted; } }
            VerticalLayout { alignment: center; ActionButton { text: "Scan my companies"; primary: true; enabled: !App.scanning; clicked => { App.scan(-1); } } }
        }
        ScanBar { }
        HorizontalLayout {
            spacing: 10px;
            search := SearchField { width: 320px; placeholder: "Search role or company"; edited(t) => { App.discover-filter(t, country.current-value, state.current-value); } }
            country := Select { width: 200px; model: App.countries; selected(v) => { App.discover-filter(search.text, v, state.current-value); } }
            state := Select { width: 150px; model: ["New", "Tailoring", "Dismissed", "All"]; selected(v) => { App.discover-filter(search.text, country.current-value, v); } }
            Rectangle { horizontal-stretch: 1; }
            Text { text: App.discover-total + " roles"; font-family: Theme.body; font-size: Theme.fs-xs; color: Theme.muted; vertical-alignment: center; }
        }
        if App.discovered.length == 0 : Text { text: "Nothing here yet. Mark companies as favourites on the Companies page, then scan them.";
                                               font-family: Theme.body; font-size: Theme.fs-sm; color: Theme.muted; }
        ListView { vertical-stretch: 1; for d in App.discovered : DiscoverItem { d: d; } }
        Pager { page: App.discover-page; pages: App.discover-pages; go(p) => { App.go-page("discover", p); } }
    }
}
