// Shared controls. Stock widgets look small and grey on macOS, so the app draws its own.
import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    in property <bool> small;
    callback clicked;
    height: small ? 32px : 40px;
    width: t.preferred-width + (small ? 24px : 34px);
    border-radius: Theme.r-control;
    opacity: enabled ? 1 : 0.45;
    background: primary ? (touch.pressed ? Theme.accent.darker(0.2) : touch.has-hover ? Theme.accent.darker(0.1) : Theme.accent)
              : danger ? (touch.has-hover ? Theme.risk-soft : Theme.surface)
              : (touch.has-hover ? Theme.selected : Theme.surface);
    border-width: primary ? 0px : 1px;
    border-color: danger ? Theme.risk.with-alpha(0.5) : Theme.line;
    t := Text { text: root.text; font-family: Theme.body; font-size: root.small ? Theme.fs-xs : Theme.fs-sm; font-weight: 700;
                color: root.primary ? (Theme.dark ? #062520 : white) : root.danger ? Theme.risk : Theme.ink;
                horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); fs.focus(); } mouse-cursor: root.enabled ? pointer : default; }
    fs := FocusScope {
        focus-on-click: false;   // a click goes to the button; the scope is only for the keyboard
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" { root.clicked(); return accept; }
            reject
        }
    }
    if fs.has-focus : Rectangle { border-radius: root.border-radius + 3px; x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px;
                                   border-width: 2px; border-color: Theme.accent; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
}

// Text-only link-style button ("← Applications", "Copy").
export component LinkButton inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.accent;
    callback clicked;
    height: 28px;
    // Takes its text's width, but gives way (with "…") when the row runs out of room.
    preferred-width: t.preferred-width + 8px;
    max-width: t.preferred-width + 8px;
    min-width: min(48px, t.preferred-width + 8px);
    border-radius: 6px;
    background: touch.has-hover ? Theme.selected : transparent;
    t := Text { x: 4px; width: parent.width - 8px; text: root.text; font-family: Theme.body; font-size: Theme.fs-sm; font-weight: 700; color: root.ink;
                horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    touch := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
}

export component SearchField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text: "";
    in property <bool> password;
    callback edited(string);
    callback accepted(string);
    height: 40px;
    border-radius: Theme.r-control;
    background: Theme.surface;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        Rectangle {
            input := TextInput {
                text <=> root.text;
                font-family: Theme.body; font-size: Theme.fs-sm; color: Theme.ink; vertical-alignment: center;
                single-line: true;
                input-type: root.password ? InputType.password : InputType.text;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
                accessible-label: root.placeholder;
            }
            if input.text == "" : Text { text: root.placeholder; font-family: Theme.body; font-size: Theme.fs-sm;
                                         color: Theme.faint; vertical-alignment: center; x: 0; }
        }
    }
}

// A labelled single-line field for forms.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> placeholder;
    in property <bool> password;
    in-out property <string> text;
    callback edited(string);
    // Equal share of a row whatever the content, so form columns line up.
    preferred-width: 100px;
    horizontal-stretch: 1;
    spacing: 6px;
    Text { text: root.label; font-family: Theme.body; font-size: Theme.fs-xs; font-weight: 700; color: Theme.muted; }
    SearchField { text <=> root.text; placeholder: root.placeholder; password: root.password; edited(t) => { root.edited(t); } }
    if root.hint != "" : Text { text: root.hint; font-family: Theme.body; font-size: 12px; color: Theme.faint; wrap: word-wrap; }
}

// Multi-line text with the app's frame (drawn by the app so it follows Light/Dark).
export component TextArea inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in-out property <string> text;
    in property <bool> read-only;
    in property <length> area-height: 160px;
    // grow: fill the space the layout gives (at least area-height) instead of a fixed height.
    in property <bool> grow;
    callback edited(string);
    spacing: 6px;
    if root.label != "" : Text { text: root.label; font-family: Theme.body; font-size: Theme.fs-xs; font-weight: 700; color: Theme.muted; }
    Rectangle {
        min-height: root.area-height;
        max-height: root.grow ? 100000px : root.area-height;
        vertical-stretch: root.grow ? 1 : 0;
        border-radius: Theme.r-control;
        background: Theme.surface;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.accent : Theme.line;
        clip: true;
        flick := Flickable {
            x: 12px; y: 10px; width: parent.width - 24px; height: parent.height - 20px;
            content-height: max(self.height, input.preferred-height);
            input := TextInput {
                width: flick.width;
                text <=> root.text;
                read-only: root.read-only;
                single-line: false;
                wrap: word-wrap;
                font-family: Theme.body; font-size: Theme.fs-sm; color: Theme.ink;
                selection-background-color: Theme.accent.with-alpha(0.3);
                edited => { root.edited(self.text); }
                // keep the caret in view while typing
                cursor-position-changed(pos) => {
                    if pos.y + 24px > -flick.content-y + flick.height { flick.content-y = -(pos.y + 24px - flick.height); }
                    if pos.y < -flick.content-y { flick.content-y = -pos.y; }
                }
            }
        }
        TouchArea { width: parent.width; height: max(0px, parent.height - input.preferred-height - 20px); y: parent.height - self.height;
                    clicked => { input.focus(); } mouse-cursor: MouseCursor.text; }
    }
    if root.hint != "" : Text { text: root.hint; font-family: Theme.body; font-size: 12px; color: Theme.faint; wrap: word-wrap; }
}

export component Toggle inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 28px;
    HorizontalLayout {
        spacing: 10px; alignment: start;
        Rectangle {
            width: 40px; height: 22px; y: 3px; border-radius: 11px;
            background: root.checked ? Theme.accent : Theme.line;
            animate background { duration: 120ms; }
            Rectangle { width: 16px; height: 16px; y: 3px; x: root.checked ? 21px : 3px; border-radius: 8px; background: white;
                        animate x { duration: 120ms; easing: ease-out; } }
        }
        Text { text: root.text; font-family: Theme.body; font-size: Theme.fs-sm; color: Theme.ink; vertical-alignment: center; }
    }
    TouchArea { clicked => { root.checked = !root.checked; root.toggled(root.checked); } mouse-cursor: pointer; }
    accessible-role: checkbox;
    accessible-checked: root.checked;
    accessible-label: root.text;
}

export component Tabs inherits Rectangle {
    in property <[string]> labels;
    in-out property <int> current;
    callback changed(int);
    height: 44px;
    HorizontalLayout {
        spacing: 4px; alignment: start;
        for label[i] in root.labels : Rectangle {
            width: t.preferred-width + 28px;
            property <bool> on: i == root.current;
            t := Text { text: label; font-family: Theme.body; font-size: Theme.fs-sm; font-weight: on ? 700 : 500;
                        color: on ? Theme.ink : touch.has-hover ? Theme.ink : Theme.muted;
                        horizontal-alignment: center; vertical-alignment: center; }
            Rectangle { y: parent.height - 3px; height: 3px; border-radius: 1.5px; background: on ? Theme.marigold : transparent; }
            touch := TouchArea { clicked => { root.current = i; root.changed(i); } mouse-cursor: pointer; }
            accessible-role: tab;
            accessible-label: label;
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> fg: Theme.ink;
    in property <color> bg: Theme.sunken;
    height: 26px;
    width: t.preferred-width + 18px;
    border-radius: 13px;
    background: bg;
    t := Text { text: root.text; font-family: Theme.body; font-size: Theme.fs-xs; font-weight: 700; color: root.fg;
                horizontal-alignment: center; vertical-alignment: center; }
}

// Wrapping row of chips (Slint has no flow layout: rows are packed by width).
export component ChipFlow inherits Rectangle {
    in property <[string]> items;
    in property <color> fg: Theme.ink;
    in property <color> bg: Theme.sunken;
    in property <string> empty: "None";
    property <length> gap: 6px;
    // Estimated chip width (13px font ≈ 7px per char).
    property <length> avg: 7.2px;
    height: max(26px, self.rows * 32px - gap);
    property <int> per-row: max(1, floor(self.width / 150px));
    property <int> rows: items.length == 0 ? 1 : ceil(items.length / per-row);
    if items.length == 0 : Text { text: root.empty; font-family: Theme.body; font-size: Theme.fs-xs; color: Theme.faint; y: 4px; }
    for item[i] in root.items : Chip {
        text: item; fg: root.fg; bg: root.bg;
        x: mod(i, root.per-row) * (root.width / root.per-row);
        y: floor(i / root.per-row) * 32px;
        width: min(self.preferred-width, root.width / root.per-row - root.gap);
    }
}

// Three dots that breathe while agents work (the one ambient animation in the app).
export component Working inherits HorizontalLayout {
    in property <color> color: Theme.marigold;
    spacing: 4px;
    for i in 3 : Rectangle {
        width: 7px; height: 7px; y: (parent.height - 7px) / 2; border-radius: 3.5px;
        background: root.color;
        opacity: 0.25 + 0.75 * abs(sin((animation-tick() / 1ms / 4 - i * 70) * 1deg));
    }
}

export component SectionTitle inherits Text {
    font-family: Theme.display;
    font-weight: 700;
    font-size: Theme.fs-lg;
    color: Theme.ink;
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.r-panel;
    border-width: 1px;
    border-color: Theme.line;
}

// Bulleted list of plain lines.
export component Bullets inherits VerticalLayout {
    in property <[string]> items;
    in property <color> dot: Theme.accent;
    spacing: 8px;
    // Each line is a direct child of the layout so wrapped text reports its real height.
    for item in root.items : Text {
        text: "•   " + item; wrap: word-wrap; font-family: Theme.body; font-size: Theme.fs-sm; color: Theme.ink;
    }
}

// Drop-down list in the app's style (replaces the stock ComboBox).
export component Select inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    // Forms bind `value` (the chosen text); lists that need positions use `current-index`.
    in-out property <string> value;
    in property <bool> by-value;
    out property <string> current-value: by-value ? value : model.length > 0 && current-index >= 0 && current-index < model.length ? model[current-index] : "";
    callback selected(string);
    property <length> item-h: 34px;
    height: 40px;
    min-width: 120px;
    border-radius: Theme.r-control;
    background: touch.has-hover ? Theme.selected : Theme.surface;
    border-width: fs.has-focus ? 2px : 1px;
    border-color: fs.has-focus ? Theme.accent : Theme.line;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 8px;
        Text { text: root.current-value == "" ? "Choose…" : root.current-value; font-family: Theme.body; font-size: Theme.fs-sm;
               color: root.current-value == "" ? Theme.faint : Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { text: "▾"; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
    }
    touch := TouchArea { clicked => { fs.focus(); popup.show(); } mouse-cursor: pointer; }
    fs := FocusScope {
        focus-on-click: false;   // a click goes to the button; the scope is only for the keyboard
        key-pressed(e) => {
            if e.text == Key.DownArrow && root.current-index < root.model.length - 1 { root.current-index += 1; if (root.by-value) { root.value = root.model[root.current-index]; } root.selected(root.current-value); return accept; }
            if e.text == Key.UpArrow && root.current-index > 0 { root.current-index -= 1; if (root.by-value) { root.value = root.model[root.current-index]; } root.selected(root.current-value); return accept; }
            if e.text == " " || e.text == "\n" { popup.show(); return accept; }
            reject
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: min(320px, root.model.length * root.item-h + 10px);
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.r-control;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 4px;
            clip: true;
            Flickable {
                content-height: root.model.length * root.item-h + 10px;
                VerticalLayout {
                    padding: 5px;
                    for item[i] in root.model : Rectangle {
                        height: root.item-h;
                        border-radius: 6px;
                        background: ta.has-hover ? Theme.selected : transparent;
                        Text { x: 10px; width: parent.width - 20px; text: item; font-family: Theme.body; font-size: Theme.fs-sm;
                               font-weight: item == root.current-value ? 700 : 400;
                               color: item == root.current-value ? Theme.accent : Theme.ink; vertical-alignment: center; overflow: elide; }
                        ta := TouchArea { clicked => { root.current-index = i; if (root.by-value) { root.value = item; } root.selected(item); } mouse-cursor: pointer; }
                    }
                }
            }
        }
    }
    accessible-role: combobox;
    accessible-value: root.current-value;
}

// A chip with a remove button.
export component RemovableChip inherits Rectangle {
    in property <string> text;
    callback remove;
    height: 30px;
    border-radius: 15px;
    background: Theme.accent-soft;
    HorizontalLayout {
        padding-left: 12px; padding-right: 4px; spacing: 4px;
        Text { text: root.text; font-family: Theme.body; font-size: Theme.fs-xs; font-weight: 700; color: Theme.accent; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Rectangle {
            width: 22px; height: 22px; y: 4px; border-radius: 11px;
            background: x.has-hover ? Theme.accent.with-alpha(0.25) : transparent;
            Text { text: "×"; font-size: 15px; color: Theme.accent; }
            x := TouchArea { clicked => { root.remove(); } mouse-cursor: pointer; }
            accessible-role: button;
            accessible-label: "Remove " + root.text;
        }
    }
}

// Several values picked from suggestions or typed, shown as removable chips.
// The list lives in Rust: `add` / `remove` / `typed` report changes, `suggestions` comes back.
export component ChipInput inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> placeholder: "Type and press Enter";
    in property <[string]> items;
    in property <[string]> suggestions;
    callback add(string);
    callback remove(int);
    callback typed(string);
    property <int> per-row: max(1, floor(self.width / 180px));
    preferred-width: 100px;
    horizontal-stretch: 1;
    spacing: 6px;
    Text { text: root.label; font-family: Theme.body; font-size: Theme.fs-xs; font-weight: 700; color: Theme.muted; }
    if root.items.length > 0 : Rectangle {
        height: ceil(root.items.length / root.per-row) * 36px - 6px;
        for item[i] in root.items : RemovableChip {
            text: item;
            x: mod(i, root.per-row) * (parent.width / root.per-row);
            y: floor(i / root.per-row) * 36px;
            width: min(self.preferred-width, parent.width / root.per-row - 6px);
            remove => { root.remove(i); }
        }
    }
    Rectangle {
        height: 40px;
        field := SearchField {
            width: parent.width;
            placeholder: root.placeholder;
            edited(t) => { root.typed(t); if (t != "") { pop.show(); } }
            accepted(t) => { if (t != "") { root.add(t); self.text = ""; root.typed(""); } }
        }
        pop := PopupWindow {
            x: 0; y: 44px; width: field.width;
            height: min(240px, root.suggestions.length * 34px + 10px);
            Rectangle {
                visible: root.suggestions.length > 0;
                background: Theme.surface; border-radius: Theme.r-control; border-width: 1px; border-color: Theme.line;
                drop-shadow-blur: 16px; drop-shadow-color: #00000040; drop-shadow-offset-y: 4px; clip: true;
                VerticalLayout {
                    padding: 5px;
                    for s in root.suggestions : Rectangle {
                        height: 34px; border-radius: 6px;
                        background: ta.has-hover ? Theme.selected : transparent;
                        Text { x: 10px; text: s; font-family: Theme.body; font-size: Theme.fs-sm; color: Theme.ink; vertical-alignment: center; }
                        ta := TouchArea { clicked => { root.add(s); field.text = ""; root.typed(""); } mouse-cursor: pointer; }
                    }
                }
            }
        }
    }
    if root.hint != "" : Text { text: root.hint; font-family: Theme.body; font-size: 12px; color: Theme.faint; wrap: word-wrap; }
}

// A labelled drop-down for forms.
export component SelectField inherits VerticalLayout {
    in property <string> label;
    in property <[string]> options;
    in-out property <string> value;
    preferred-width: 100px;
    horizontal-stretch: 1;
    spacing: 6px;
    Text { text: root.label; font-family: Theme.body; font-size: Theme.fs-xs; font-weight: 700; color: Theme.muted; }
    Select { model: root.options; by-value: true; value <=> root.value; }
}

// "‹ Previous   Page 2 of 5   Next ›" under a long list.
export component Pager inherits HorizontalLayout {
    in property <int> page;      // 0-based
    in property <int> pages;
    in property <string> summary;
    callback go(int);
    visible: pages > 1 || summary != "";
    height: pages > 1 || summary != "" ? 48px : 0px;
    spacing: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    Text { text: root.summary; font-family: Theme.body; font-size: Theme.fs-xs; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; }
    if root.pages > 1 : ActionButton { text: "‹ Previous"; small: true; enabled: root.page > 0; clicked => { root.go(root.page - 1); } }
    if root.pages > 1 : Text { text: "Page " + (root.page + 1) + " of " + root.pages; font-family: Theme.body; font-size: Theme.fs-xs; font-weight: 700; color: Theme.ink; vertical-alignment: center; }
    if root.pages > 1 : ActionButton { text: "Next ›"; small: true; enabled: root.page < root.pages - 1; clicked => { root.go(root.page + 1); } }
}

// Small quiet button shown on a list row while hovered ("Close").
export component RowAction inherits Rectangle {
    in property <string> text;
    // Visible while the row is hovered, and while the pointer is on the button itself.
    in property <bool> show;
    out property <bool> showing: show || touch.has-hover;
    callback clicked;
    opacity: showing ? 1 : 0;
    height: 30px;
    width: t.preferred-width + 22px;
    border-radius: 15px;
    background: touch.has-hover ? Theme.risk-soft : Theme.surface;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.risk.with-alpha(0.5) : Theme.line;
    t := Text { text: root.text; font-family: Theme.body; font-size: Theme.fs-xs; font-weight: 700;
                color: touch.has-hover ? Theme.risk : Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
}

export component Checkbox inherits Rectangle {
    in property <bool> checked;
    callback toggled;
    width: 20px; height: 20px;
    border-radius: 5px;
    background: checked ? Theme.accent : touch.has-hover ? Theme.selected : Theme.surface;
    border-width: checked ? 0px : 1.5px;
    border-color: Theme.faint;
    if root.checked : Text { text: "✓"; color: Theme.dark ? #062520 : white; font-size: 13px; font-weight: 700; }
    touch := TouchArea { clicked => { root.toggled(); } mouse-cursor: pointer; }
    accessible-role: checkbox;
    accessible-checked: root.checked;
}
